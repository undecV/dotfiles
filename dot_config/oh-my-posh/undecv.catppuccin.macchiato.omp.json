{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "base": "#24273a",
    "mantle": "#1e2030",
    "crust": "#181926",
    "text": "#cad3f5",
    "subtext1": "#b8c0e0",
    "surface1": "#494d64",
    "blue": "#8aadf4",
    "pink": "#f5bde6",
    "lavender": "#b7bdf8",
    "teal": "#8bd5ca",
    "green": "#a6da95",
    "yellow": "#eed49f",
    "peach": "#f5a97f",
    "red": "#ed8796",
    "mauve": "#c6a0f6"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "powerline_symbol": "",
          "background": "p:blue",
          "foreground": "p:base",
          "template": " {{ .Icon }} {{ .UserName }}@{{ .HostName }} ",
          "background_templates": [
            "{{ if .Root }}p:peach{{ end }}"
          ]
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "options": {
            "folder_icon": "..",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "template": " {{ .Path }} ",
          "background": "p:pink",
          "foreground": "p:base"
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "options": {
            "branch_icon": " ",
            "cherry_pick_icon": " ",
            "commit_icon": " ",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": " ",
            "no_commits_icon": " ",
            "rebase_icon": " ",
            "revert_icon": " ",
            "tag_icon": " "
          },
          "template": " {{ .HEAD }} ",
          "background": "p:lavender",
          "foreground": "p:base"
        },
        {
          "type": "time",
          "style": "powerline",
          "powerline_symbol": "",
          "options": {
            "time_format": "2006-01-02 15:04:05 MST"
          },
          "template": " {{ .CurrentDate | date \"2006-01-02 15:04:05 MST\" }} ",
          "background": "p:teal",
          "foreground": "p:base"
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "background": "p:green",
          "background_templates": [
            "{{ if ne .Code 0 }}p:red{{ end }}"
          ],
          "foreground": "p:base",
          "options": {
            "always_enabled": true,
            "threshold": 0,
            "style": "austin"
          },
          "template": "{{ if or (ge .Ms 1000) (ne .Code 0) }} {{ if ge .Ms 1000 }}{{ .FormattedMs }}{{ if ne .Code 0 }} {{ end }}{{ end }}{{ if ne .Code 0 }}✘ {{ .Code }}{{ end }} {{ end }}",
          "powerline_symbol": ""
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "background": "transparent",
          "foreground": "p:blue",
          "foreground_templates": [
            "{{ if ne .Code 0 }}p:red{{ end }}",
            "{{ if .Root }}p:peach{{ end }}"
          ],
          "template": "{{ if .Root }}#{{ else }}>{{ end }}"
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:blue",
    "foreground_templates": [
      "{{ if ne .Code 0 }}p:red{{ end }}",
      "{{ if .Root }}p:peach{{ end }}"
    ],
    "template": "{{ if .Root }}#{{ else }}>{{ end }} "
  },
  "final_space": true,
  "version": 4
}
